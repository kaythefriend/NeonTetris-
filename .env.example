# Base RPC endpoint (mainnet). Get a free one from Alchemy, Infura, or use the public default.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# USDC contract address on Base mainnet (native USDC, not bridged USDbC)
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Wallet that receives the 0.1 USDC pay-to-play fees (your treasury/house wallet)
NEXT_PUBLIC_TREASURY_ADDRESS=0xYourTreasuryWalletAddressHere

# Cost to play a single game, in USDC (human units, gets converted to 6-decimal base units)
NEXT_PUBLIC_GAME_FEE_USDC=0.1

# Flat price to purchase any non-default skin, in USDC.
NEXT_PUBLIC_SKIN_PRICE_USDC=1

# --- Duel auto-payout (server-signed) ---
# Private key of a DEDICATED wallet used ONLY to auto-pay duel winners.
# Do NOT use your personal wallet or the treasury wallet's own key here if
# they're meant to be the same address as NEXT_PUBLIC_TREASURY_ADDRESS —
# whichever wallet this key controls needs to actually hold the USDC that
# gets paid out, so it should be the same address as
# NEXT_PUBLIC_TREASURY_ADDRESS, funded deliberately, and monitored. If this
# key leaks, everything in that wallet can be drained instantly with no
# human approval step — treat it with the same care as a hot exchange wallet.
# NEVER prefix this with NEXT_PUBLIC_ (that would ship it to every browser).
TREASURY_PRIVATE_KEY=

# --- Farcaster user search (for the duel "search a friend" flow) ---
# Get a free-tier key at https://neynar.com. Also used to verify webhook
# event signatures in /api/webhook (verifyAppKeyWithNeynar).
NEYNAR_API_KEY=

# Farcaster Mini App manifest signing (from the Farcaster developer portal)
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# Public URL this app is deployed at (used in the farcaster.json manifest + embeds)
NEXT_PUBLIC_APP_URL=https://neontetris.example.com

# --- Persistent storage (required before going live with real payments) ---
# Without these, the app falls back to a local JSON file for storage, which
# does NOT persist reliably on Vercel (read-only filesystem outside /tmp,
# not shared across invocations) and does NOT safely prevent payment replay.
# Easiest path: in the Vercel dashboard, add the "Upstash Redis" (or "KV")
# integration/marketplace product to this project — it injects these two
# vars automatically. No code changes needed once they're set.
KV_REST_API_URL=
KV_REST_API_TOKEN=
